<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>strata</AssemblyName>
    <RootNamespace>Strata.Host</RootNamespace>

    <!--
      The manifest is asInvoker. It is still worth having for longPathAware and the UTF-8 code page,
      both of which matter on a machine with npm and NuGet caches.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      The executable's own icon: what a desktop or Start Menu shortcut shows, what Alt-Tab shows,
      and what File Explorer draws next to strata.exe. The idle state, because that is what the
      application is when nobody is looking at it.
    -->
    <ApplicationIcon>..\..\docs\design\icon\strata.ico</ApplicationIcon>

    <!--
      Framework-dependent, and allowed to roll forward a major version.

      `strata install` puts this build somewhere permanent and a scheduled task starts it at every
      logon, so the one thing that must not happen is a silent failure to start: with no console
      attached, "you must install .NET" goes nowhere anybody will read it. Self-contained removes
      that risk and costs 105.5 MB against 3.8 MB — measured, both, in docs/MEASUREMENTS.md — which
      is a poor trade for a tool whose entire subject is what is filling up your disk.

      RollForward=Major buys the same safety for nothing: Strata runs on .NET 9 while it is there,
      and on the lowest higher major if it is ever removed. `Major` rather than `LatestMajor`, which
      would jump to .NET 10 on this machine today and quietly run the shipped process on a runtime
      the tests never saw.

      Publish self-contained anyway with tools/publish.ps1 -SelfContained if a machine will not have
      a runtime at all.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strata.Core\Strata.Core.csproj" />
    <ProjectReference Include="..\Strata.Platform\Strata.Platform.csproj" />
    <ProjectReference Include="..\Strata.Storage\Strata.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A framework reference rather than the Web SDK. This project is a console executable that
      happens to host a listener; switching to Microsoft.NET.Sdk.Web would bring wwwroot conventions,
      launch profiles and appsettings binding that nothing here uses.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The Angular app, compiled to static files and copied into the executable's output.

    At runtime there is no Node, no `ng serve`, no second process: `ng build` produces plain HTML,
    CSS and JavaScript at *build* time and this copies it next to strata.exe as wwwroot. See
    docs/RUNTIME.md.

    Running npm is opt-in rather than automatic. `dotnet build` and `dotnet test` have to work on a
    machine with no Node installed — the backend is four projects and 161 tests that have nothing to
    do with the UI, and making them depend on an npm install would be a poor trade for the
    convenience of one command. Build the UI with:

        dotnet build src/Strata.Host -p:BuildWebUi=true

    or by running `npm run build` in src/Strata.Web yourself. Whatever is in dist gets copied either
    way, and if nothing is there the host serves the API alone and says so on startup.
  -->
  <PropertyGroup>
    <WebProjectDir>$(MSBuildThisFileDirectory)..\Strata.Web\</WebProjectDir>
    <BuildWebUi Condition="'$(BuildWebUi)' == ''">false</BuildWebUi>
  </PropertyGroup>

  <Target Name="BuildAngularApp"
          BeforeTargets="CollectWebAssets"
          Condition="'$(BuildWebUi)' == 'true'">
    <Message Importance="high" Text="Building the Angular app in $(WebProjectDir)..." />

    <Exec Command="npm ci"
          WorkingDirectory="$(WebProjectDir)"
          Condition="!Exists('$(WebProjectDir)node_modules')" />

    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDir)" />
  </Target>

  <!--
    Globbed inside a target rather than in a plain ItemGroup, because the files may not exist when
    the project is evaluated — a build that produces them in the same pass would otherwise copy the
    previous build's output, or nothing at all on the first one.
  -->
  <!--
    The tray's state icons. Placeholders until the real artwork lands from Claude Design against
    docs/design/ICON-BRIEF.md; the tray reads whatever is here and draws nothing if it is missing.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\docs\design\icon\*.ico"
             Link="icons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CollectWebAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_WebAsset Include="$(WebProjectDir)dist\**\*" />

      <Content Include="@(_WebAsset)"
               Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Importance="normal"
             Text="Web assets: @(_WebAsset->Count()) files from $(WebProjectDir)dist" />
  </Target>

</Project>
